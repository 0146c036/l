# ==============================================================================
# 會議提醒系統 - 環境變數設定範例 (.env)
# 請將本檔案複製為 .env 並填入實際的參數值。請勿將 .env 提交至 Git 版本控制。
# ==============================================================================

# 伺服器連接埠 (預設 5000)
PORT=5000

# LINE 機器人相關設定 (LINE Developers 取得)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here
# 目標接收通知的 LINE 使用者 ID (從 LINE Developers 或 Webhook log 取得)
LINE_USER_ID=your_line_user_id_here

# Gmail SMTP 郵件伺服器設定
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
# 接收提醒通知信的目標 Email 信箱
EMAIL_TO=recipient_email@example.com

# Gemini API 憑證 (用於解析使用者說話內容)
GEMINI_API_KEY=your_gemini_api_key_here

# Google 行事曆 API 相關憑證 (運行 authorize_google.py 後取得內容)
# 本地測試時可以直接把 credentials.json 與 token.json 放在專案目錄下。
# 部署至雲端 (Render/Railway) 時，請把這兩個 JSON 檔案的內容複製成單行 JSON，並設定於下方環境變數：
GOOGLE_CREDENTIALS_JSON={"installed":{"client_id":"...","project_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_secret":"...","redirect_uris":["http://localhost"]}}
GOOGLE_TOKEN_JSON={"token":"...","refresh_token":"...","token_uri":"...","client_id":"...","client_secret":"...","scopes":["..."],"expiry":"..."}
